          "informationUri": "https://github.com/GusRVPaulino/sast-devsecops-fiap",
          "rules": [
            {
              "id": "pii.mapa.documento",
              "name": "pii_mapa_documento",
              "shortDescription": {
                "text": "Dado pessoal mapeado: CPF e documentos"
              },
              "fullDescription": {
                "text": "`cpf` guarda CPF ou outros documentos. Confira se o dado é necessário e se está protegido."
              },
              "help": {
                "text": "Colete só o necessário (LGPD, art. 6º, III), proteja o dado em repouso com criptografia e nunca envie para logs, URLs ou notificações.",
                "markdown": "Colete só o necessário (LGPD, art. 6º, III), proteja o dado em repouso com criptografia e nunca envie para logs, URLs ou notificações."
              },
              "helpUri": "https://www.planalto.gov.br/ccivil_03/_ato2015-2018/2018/lei/l13709.htm",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-359"
                ],
                "security-severity": "1.0",
                "precision": "medium"
              }
            },
            {
              "id": "pii.mapa.contato",
              "name": "pii_mapa_contato",
              "shortDescription": {
                "text": "Dado pessoal mapeado: Contato e endereço"
              },
              "fullDescription": {
                "text": "`telefone` guarda telefone, e-mail ou endereço. Confira se o dado é necessário e se está protegido."
              },
              "help": {
